# PostgreSQL connection string for LOCAL (non-Docker) development, e.g. `npm run dev` against
# `docker compose up postgres` or a native Postgres install. Not used when running the full stack
# via `docker compose up` — docker-compose.yml sets DATABASE_URL itself for the web/worker containers.
DATABASE_URL="postgresql://mailpilot:mailpilot@localhost:5432/mailpilot?schema=public"

# Auth.js
# Generate with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth 2.0 client (Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
# Required scope requested by the app: https://www.googleapis.com/auth/gmail.send
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AES-256-GCM key used to encrypt OAuth tokens at rest. Must be a base64-encoded 32-byte key.
# Generate with: npm run generate-key
ENCRYPTION_KEY=""

# Transactional email (password reset, welcome) — separate from campaign sending, which
# always goes through a customer's own connected Gmail. Optional: without it, these
# emails are logged to the console instead of sent, so auth flows still work in dev.
RESEND_API_KEY=""
SYSTEM_EMAIL_FROM="LyneSign Marketing <onboarding@resend.dev>"

# Stripe billing. Test mode keys are fine to start (Dashboard > Developers > API keys).
# Without STRIPE_SECRET_KEY, billing routes return "not configured" instead of crashing —
# everything else in the app works fine without it.
STRIPE_SECRET_KEY=""
# From `stripe listen` (local dev) or Dashboard > Developers > Webhooks (production).
STRIPE_WEBHOOK_SECRET=""
# Price IDs for the 3 paid tiers — create matching recurring Products/Prices in the
# Stripe Dashboard first (Starter $29/mo, Pro $79/mo, Agency $199/mo), then paste their
# price IDs here. Read by prisma/seed.ts; a tier left blank just can't be checked out yet.
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_AGENCY=""

# Comma-separated emails granted access to /admin (customer list, suspend/delete, revenue).
# No in-app way to grant this — it's deliberately an infra-level secret, not application data.
ADMIN_EMAILS=""

# Monday.com OAuth2 app (developer.monday.com > My Apps > OAuth). Only Pro/Agency-tier
# accounts can connect (Plan.crmEnabled) — see src/lib/billing.ts's requireCrmEnabled.
# Authorized redirect URI: {NEXTAUTH_URL}/api/integrations/monday/callback
MONDAY_CLIENT_ID=""
MONDAY_CLIENT_SECRET=""

# Meta App (developers.facebook.com) with the Facebook Login and Instagram Graph API
# products added. Authorized redirect URI: {NEXTAUTH_URL}/api/social/meta/callback
# Real (non-test) users can't complete this OAuth flow until Meta grants Business
# Verification + App Review for pages_manage_posts/instagram_content_publish — until
# then it only works for the app's own added Test Users/Roles.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
