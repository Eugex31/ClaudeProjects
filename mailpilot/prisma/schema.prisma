generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js (NextAuth) models ----------

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?  @db.Timestamptz(3)
  image         String?
  // Set only for accounts registered with email/password. Google-only
  // accounts have no password — see src/lib/auth.ts and the /api/auth/*
  // routes, which manage Sessions directly instead of via a NextAuth
  // CredentialsProvider (that provider assumes JWT sessions; this app
  // deliberately keeps database sessions everywhere so an admin suspension
  // can kill a session immediately instead of waiting out a JWT's expiry).
  passwordHash  String?
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?  @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)

  accounts     Account[]
  sessions     Session[]
  contacts     Contact[]
  contactLists ContactList[]
  campaigns    Campaign[]
  settings     Settings?
  sendCounters SendCounter[]
  subscription Subscription?
  tags              Tag[]
  templates         Template[]
  templateImages    TemplateImage[]
  sequences         Sequence[]
  newsletters       Newsletter[]
  mondayIntegration        MondayIntegration?
  starterTemplateFavorites StarterTemplateFavorite[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  // access_token / refresh_token are stored ENCRYPTED (AES-256-GCM) — see lib/crypto/tokenCipher.ts.
  // Never read/write these columns directly outside lib/gmail/getGmailClient.ts and the auth adapter wrapper.
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
}

// ---------- Application models ----------

model Contact {
  id           String   @id @default(cuid())
  userId       String
  firstName    String?
  lastName     String?
  email        String
  company      String?
  jobTitle     String?
  website      String?
  greet        String?
  customFields Json?
  appointmentAt DateTime? @db.Timestamptz(3)
  mondayDirty  Boolean  @default(false)
  mondayItemId String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listMemberships     ContactListMembership[]
  campaignRecipients  CampaignRecipient[]
  tags                ContactTag[]
  sequenceEnrollments SequenceEnrollment[]

  @@unique([userId, email])
  @@index([userId])
  @@index([userId, mondayDirty])
}

model ContactList {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberships ContactListMembership[]
  campaigns   Campaign[]

  @@index([userId])
}

model ContactListMembership {
  contactId String
  listId    String

  contact Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  list    ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([contactId, listId])
}

// Dynamic segments, distinct from ContactList's static/manually-curated
// membership — a Tag is what campaigns/sequences filter contacts by
// ("everyone tagged hot-lead"), not a group you explicitly built once.
model Tag {
  id     String @id @default(cuid())
  userId String
  name   String

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts    ContactTag[]
  sequences   Sequence[]
  newsletters Newsletter[]

  @@unique([userId, name])
  @@index([userId])
}

model ContactTag {
  contactId String
  tagId     String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

// RICH_TEXT (default) is the Tiptap-editor subset every existing row already
// is; HTML is a full document (tables, images, a <style> block) sanitized
// through a wider, still-mandatory allowlist — see composeEmail.ts.
enum BodyFormat {
  RICH_TEXT
  HTML
}

model Template {
  id           String     @id @default(cuid())
  userId       String
  name         String
  subject      String
  body         String     @db.Text
  bodyFormat   BodyFormat @default(RICH_TEXT)
  // Raw MJML source from the visual drag-and-drop editor. Null for every
  // template never opened there (all seeded/copied starters, all plain
  // rich-text/HTML templates) — body/bodyFormat stay the single source of
  // truth for what actually sends; this is only the editor's re-openable
  // source, written exclusively by its own save path.
  editorSource String?    @db.Text
  categoryId   String?
  isFavorite   Boolean    @default(false)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    TemplateCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  newsletters Newsletter[]

  @@index([userId])
}

// A customer's own uploaded images for use inside the visual template editor
// (e.g. their own logo via the Image block) — a real multi-row-per-user model,
// unlike Settings.signatureLogo's single-slot-per-account design. Served
// publicly (see GET /api/template-images/[id]) since real recipients' mail
// clients fetch these with no session, same reasoning as the public
// tracking-pixel route.
model TemplateImage {
  id          String   @id @default(cuid())
  userId      String
  data        Bytes
  contentType String
  filename    String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Fixed, platform-wide taxonomy (not per-customer-configurable) shared by both
// StarterTemplate and customers' own Template rows — stored as data so new
// categories can be added later without a code change, not a Prisma enum.
model TemplateCategory {
  id        String @id @default(cuid())
  key       String @unique
  label     String
  sortOrder Int    @default(0)

  starterTemplates StarterTemplate[]
  templates        Template[]
}

// Platform-wide starter content, deliberately a separate model from Template
// rather than a nullable-userId row in it (same "global data gets its own
// model" precedent as Plan vs Subscription) — customers can never edit or
// delete these directly; "Edit" copies one into their own Template instead.
model StarterTemplate {
  id         String     @id @default(cuid())
  key        String     @unique // stable seed identity — lets the seed script upsert instead of
  // delete-and-recreate, so re-seeding never wipes customers' StarterTemplateFavorite rows
  name       String
  subject    String
  body       String     @db.Text
  bodyFormat BodyFormat @default(RICH_TEXT)
  categoryId String?
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(3)

  category  TemplateCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  favorites StarterTemplateFavorite[]

  @@index([categoryId])
}

// Favoriting shared starter content is inherently per-customer — one row per
// (user, starterTemplate) pair, same composite-PK join shape as ContactTag.
model StarterTemplateFavorite {
  userId            String
  starterTemplateId String

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  starterTemplate StarterTemplate @relation(fields: [starterTemplateId], references: [id], onDelete: Cascade)

  @@id([userId, starterTemplateId])
}

enum SequenceStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum SequenceTriggerType {
  MANUAL // contacts explicitly enrolled, like campaign recipients
  TAG_ADDED // auto-enrolls when triggerTagId is added to a contact
  CONTACT_CREATED // auto-enrolls when a new contact is created
  DATE_FIELD // auto-enrolls/reschedules off Contact.appointmentAt — steps' delaySeconds mean "before" not "after"
}

model Sequence {
  id           String              @id @default(cuid())
  userId       String
  name         String
  status       SequenceStatus      @default(DRAFT)
  triggerType  SequenceTriggerType @default(MANUAL)
  triggerTagId String? // only meaningful when triggerType = TAG_ADDED
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  triggerTag  Tag?                 @relation(fields: [triggerTagId], references: [id])
  steps       SequenceStep[]
  enrollments SequenceEnrollment[]

  @@index([userId])
}

model SequenceStep {
  id           String     @id @default(cuid())
  sequenceId   String
  order        Int
  delaySeconds Int // time after the PREVIOUS step (or enrollment, for step 1)
  subject      String
  body         String     @db.Text
  bodyFormat   BodyFormat @default(RICH_TEXT)

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, order])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELED
}

model SequenceEnrollment {
  id          String           @id @default(cuid())
  sequenceId  String
  contactId   String
  status      EnrollmentStatus @default(ACTIVE)
  currentStep Int              @default(0) // steps completed so far; drives which step is next
  nextSendAt  DateTime?        @db.Timestamptz(3)
  lockedAt    DateTime?        @db.Timestamptz(3) // same stale-lock reaping pattern as CampaignRecipient
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, contactId])
  @@index([status, nextSendAt])
}

enum NewsletterStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
}

model Newsletter {
  id          String               @id @default(cuid())
  userId      String
  name        String
  templateId  String
  targetTagId String? // null = all contacts
  status      NewsletterStatus     @default(DRAFT)
  frequency   RecurrenceFrequency
  dayOfWeek   Int? // 0(Sun)-6(Sat), used when frequency = WEEKLY
  dayOfMonth  Int? // 1-31, used when frequency = MONTHLY (clamped to each month's actual length)
  hourUtc     Int // 0-23 — UTC only, no per-account timezone support yet
  minuteUtc   Int // 0-59
  nextRunAt   DateTime?            @db.Timestamptz(3)
  lastRunAt   DateTime?            @db.Timestamptz(3)
  lockedAt    DateTime?            @db.Timestamptz(3) // same stale-lock reap pattern as Campaign/Sequence
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Deliberately no onDelete: Cascade — deleting a Template still in use by a
  // Newsletter should fail with a clear FK error (caught in the template
  // DELETE route), not silently break a running automation.
  template  Template @relation(fields: [templateId], references: [id])
  targetTag Tag?     @relation(fields: [targetTagId], references: [id], onDelete: SetNull)

  @@index([userId])
}

enum CampaignStatus {
  DRAFT
  SENDING
  PAUSED
  COMPLETED
  STOPPED
  FAILED
}

model Campaign {
  id                       String         @id @default(cuid())
  userId                   String
  contactListId            String?
  name                     String
  subject                  String
  body                     String         @db.Text
  bodyFormat               BodyFormat     @default(RICH_TEXT)
  status                   CampaignStatus @default(DRAFT)
  delayMinSeconds          Int            @default(30)
  delayMaxSeconds          Int            @default(120)
  dailySendLimitOverride   Int?
  senderNameOverride       String?
  replyToOverride          String?
  unsubscribeFooterEnabled Boolean        @default(true)
  startedAt                DateTime?      @db.Timestamptz(3)
  pausedAt                 DateTime?      @db.Timestamptz(3)
  completedAt              DateTime?      @db.Timestamptz(3)
  createdAt                DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime       @updatedAt @db.Timestamptz(3)

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactList ContactList?        @relation(fields: [contactListId], references: [id])
  recipients  CampaignRecipient[]
  emailEvents EmailEvent[]

  @@index([userId])
}

enum RecipientStatus {
  PENDING
  SENDING
  SENT
  FAILED
  RETRYING
  SKIPPED
}

model CampaignRecipient {
  id              String          @id @default(cuid())
  campaignId      String
  contactId       String
  status          RecipientStatus @default(PENDING)
  scheduledAt     DateTime        @db.Timestamptz(3)
  sentAt          DateTime?       @db.Timestamptz(3)
  gmailMessageId  String?
  lastError       String?
  attemptCount    Int             @default(0)
  lockedAt        DateTime?       @db.Timestamptz(3)
  renderedSubject String?         @db.Text
  renderedBody    String?         @db.Text
  trackingToken   String          @unique @default(uuid())
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact     Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  emailEvents EmailEvent[]

  @@unique([campaignId, contactId])
  @@index([status, scheduledAt])
  @@index([campaignId])
}

enum EmailEventType {
  OPEN
  CLICK
}

model EmailEvent {
  id          String         @id @default(cuid())
  campaignId  String
  recipientId String
  type        EmailEventType
  url         String? // set only for CLICK — the original destination
  occurredAt  DateTime       @default(now()) @db.Timestamptz(3)

  campaign  Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient CampaignRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([campaignId, type])
  @@index([recipientId, type])
}

model Settings {
  userId                String   @id
  businessName          String?
  dailySendLimit        Int      @default(400)
  delayMinSeconds        Int     @default(30)
  delayMaxSeconds        Int     @default(120)
  senderName            String?
  replyTo               String?
  signatureHtml         String?  @db.Text
  signatureLogo            Bytes?
  signatureLogoContentType String?
  signatureLogoFilename    String?
  unsubscribeFooterText String?  @db.Text
  timezone              String   @default("UTC")
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SendCounter {
  userId    String
  date      DateTime @db.Date
  sentCount Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
}

// Fixed-window rate limiting. `key` embeds the window index (see
// lib/rateLimit.ts) so each window is a fresh row — no conditional reset logic needed.
model RateLimitBucket {
  key         String   @id
  windowStart DateTime @db.Timestamptz(3)
  count       Int      @default(1)
}

// ---------- Billing ----------

// Seeded (prisma/seed.ts), not user-editable.
model Plan {
  id                  String   @id @default(cuid())
  key                 String   @unique // "free" | "starter" | "pro" | "agency"
  name                String
  monthlyPriceCents   Int
  stripePriceId       String? // null for Free — Free never touches Stripe
  contactLimit        Int
  emailsPerMonthLimit Int
  activeSequenceLimit Int     // -1 sentinel = unlimited
  templateLimit       Int     @default(-1) // -1 sentinel = unlimited
  crmEnabled          Boolean @default(false)

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

// A customer on the Free plan has no row here at all — see
// getEffectiveSubscription() in src/lib/billing.ts, which mirrors
// getEffectiveSettings()'s pattern of returning a virtual default instead of
// requiring one. A row only ever gets created on a real Stripe checkout.
model Subscription {
  userId               String             @id
  planId               String
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime?          @db.Timestamptz(3)
  currentPeriodEnd     DateTime?          @db.Timestamptz(3)
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?          @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])
}

// One-way (app -> Monday) contact sync. Deliberately not the Account model —
// Account represents sign-in identity (Google), while this is a data-sync
// integration a user opts into after already being logged in. Monday's
// standard OAuth access tokens don't expire (no refresh cycle needed, unlike
// Gmail's Account rows), so there's nothing analogous to Account.expires_at.
model MondayIntegration {
  id            String    @id @default(cuid())
  userId        String    @unique
  accessToken   String    @db.Text // encrypted via lib/crypto/tokenCipher.ts
  // boardId/boardName/columnMapping are null right after OAuth connect, before
  // the user has picked a board and mapped columns — "connected but not yet
  // configured" is a real, distinct state from "no row at all" (never connected).
  boardId       String?
  boardName     String?
  columnMapping Json? // { contactField: mondayColumnId } — "email" is mandatory once set
  syncEnabled   Boolean   @default(true)
  lastSyncedAt  DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Deliberately no relations at all, not even to the admin's own account or
// the target customer — an audit log must outlive everything it describes,
// including the customer being deleted (the one action where the record
// matters most) and the admin allowlist changing later. Plain snapshot data.
model AdminAuditLog {
  id           String   @id @default(cuid())
  adminEmail   String
  targetUserId String
  targetEmail  String
  targetName   String?
  action       String // "SUSPEND" | "REACTIVATE" | "CANCEL_SUBSCRIPTION" | "DELETE" | "NOTIFY" | "ASSIGN_PLAN"
  details      String?  @db.Text
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([targetUserId])
  @@index([createdAt])
}
